# Copiar a .env y completar. El .env NO se commitea.

# Pooler COMPARTIDO de Supabase en modo SESIÓN (puerto 5432).
# Por qué este y no la conexión directa:
#   · la directa (db.<ref>.supabase.co) es sólo IPv6 y desde Railway puede no resolver
#   · el modo transacción (6543) NO soporta sentencias preparadas ni SET de sesión
DATABASE_URL=postgresql://postgres.<REF>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# "desarrollo" habilita la documentación de la API. Cualquier otro valor la apaga.
ENTORNO=desarrollo
